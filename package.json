{
  "name": "cookiejar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test",
    "test:browser": "node --test test/browser-network.test.js test/browser-observation.test.js test/browser-spike.test.js",
    "test:components": "vitest run --config vitest.config.js",
    "spike:browser": "node scripts/browser-spike.js",
    "observe:fixture": "node scripts/browser-observation.js"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "playwright-core": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.5",
    "vite": "7.3.7",
    "vitest": "^5.1.0"
  }
